{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../src/domain/production/**/*.ts",
    "../src/services/production/contracts.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "../src/**/*.test.ts"
  ]
}
