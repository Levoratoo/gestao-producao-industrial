# Frontend
NODE_ENV=development
PORT=3013
FRONTEND_PORT=3013
NEXT_PUBLIC_APP_RUNTIME=client
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SSE_URL=
NEXT_PUBLIC_HEALTH_URL=
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3013
NEXT_PUBLIC_SYNC_TRANSPORT=auto

# Backend
BACKEND_PORT=4013
DATABASE_URL=postgresql://app:app@localhost:5432/gestao_producao_industrial
DATABASE_SSL=false
FRONTEND_URL=http://localhost:3013
CORS_ALLOWED_ORIGINS=http://localhost:3013
SYNC_INTERVAL_MS=4000
LOG_LEVEL=info
APP_VERSION=0.1.0

# Verification
API_URL=http://localhost:4013
VERIFY_WAIT_MS=6500
